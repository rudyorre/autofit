# Autofit v0 Server & Storage
AUTOFIT_ADDR=:8080
AUTOFIT_DB_PATH=./data/local/autofit.db
AUTOFIT_TIMEZONE=America/Los_Angeles

# Single-Owner Auth & Optional Tailscale Bypass
# Leave AUTOFIT_OWNER_SECRET empty on private localhost/Tailscale for zero-login single-owner mode,
# or set a secret passphrase to require a signed HttpOnly session cookie.
AUTOFIT_OWNER_SECRET=
AUTOFIT_TAILSCALE_AUTH=true
AUTOFIT_TRUSTED_USER_HEADER=Tailscale-User-Login

# Google Health API v4 (Fitbit Air 24/7 + Two-Way Weight/Workout Sync)
# Note: In free Google Cloud "External -> Testing" mode, refresh tokens expire every 7 days.
# Autofit tracks token age and surfaces a 1-tap re-consent banner before expiry.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URL=http://localhost:8080/api/v1/integrations/google-health/callback
GOOGLE_HEALTH_BASE_URL=https://health.googleapis.com/v4
GOOGLE_HEALTH_SYNC_INTERVAL=15m
GOOGLE_HEALTH_WRITE_WORKOUTS=false

# Garmin Connect Personal API (Official Oct 2026 Personal Key + .FIT Runs)
GARMIN_PERSONAL_API_KEY=
GARMIN_BASE_URL=https://apis.garmin.com/personal/v1
GARMIN_SYNC_INTERVAL=30m
